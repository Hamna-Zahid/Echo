# ── EchoCoach Backend — required environment variables ──────────────────────
# Copy this file to .env and fill in all values before starting the server.

# ── Supabase ─────────────────────────────────────────────────────────────────
# Dashboard → project → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Groq (STT + LLM) ─────────────────────────────────────────────────────────
# console.groq.com → API Keys → Create key
# Free tier: 14,400 requests/day; no card needed
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Redis (session state) ─────────────────────────────────────────────────────
# console.upstash.com → Create Database → Redis → copy REST URL
# Free tier: 10,000 commands/day
REDIS_URL=rediss://default:your-password@your-instance.upstash.io:6380

# ── TTS mode ─────────────────────────────────────────────────────────────────
# edge     → Microsoft Edge Neural TTS (FREE, no key — use during development)
# cartesia → Cartesia Sonic ($6/1M chars, first 1M free — use for production)
# silent   → No audio at all (AI logic testing only)
DEV_TTS=edge

# ── Cartesia TTS (only needed if DEV_TTS=cartesia) ───────────────────────────
# play.cartesia.ai → API Keys + Voice Library
CARTESIA_API_KEY=
CARTESIA_VOICE_ID_AMERICAN=
CARTESIA_VOICE_ID_BRITISH=
