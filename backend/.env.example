# ── TTS mode ─────────────────────────────────────────────────────────────────
# edge     → Microsoft Edge Neural TTS (FREE, no key — use during development)
# cartesia → Cartesia Sonic ($6/1M chars, first 1M free — use for production)
# silent   → No audio at all (AI logic testing only)
DEV_TTS=edge

# ── Cartesia TTS (only needed if DEV_TTS=cartesia) ───────────────────────────
# play.cartesia.ai → API Keys + Voice Library
