# ─────────────────────────────────────────────
# EchoCoach — Environment Variables
# Copy to .env and fill in all values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────

# Groq API (STT + LLM)
# Get key at: console.groq.com
GROQ_API_KEY=

# Cartesia TTS
# Get key at: play.cartesia.ai
# Voice IDs: select from Cartesia voice library
CARTESIA_API_KEY=
CARTESIA_VOICE_ID_AMERICAN=
CARTESIA_VOICE_ID_BRITISH=

# Inworld AI (TTS fallback)
# Get key at: inworld.ai/studio
INWORLD_API_KEY=

# LiveKit WebRTC
# Get credentials at: livekit.io or self-host
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Supabase
# Get credentials at: supabase.com/dashboard → Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Redis (Upstash free tier recommended)
# Get credentials at: console.upstash.com
# Use the REST URL (starts with https://) and REST token
REDIS_URL=https://your-redis.upstash.io
REDIS_TOKEN=

# Backend URLs (used by mobile app — prefix with EXPO_PUBLIC_)
EXPO_PUBLIC_BACKEND_WS_URL=ws://localhost:8000
EXPO_PUBLIC_BACKEND_HTTP_URL=http://localhost:8000
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud

# Railway deployment
# Set PORT automatically by Railway — do not override unless needed
PORT=8000
