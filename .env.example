# ─────────────────────────────────────────────
# EchoCoach — Environment Variables Example
# Copy this file to .env and fill in values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────

# ── TTS MODE ──────────────────────────────────
# edge     = Microsoft Edge TTS (FREE, no key)  ← development default
# silent   = No audio, instant response         ← AI logic testing
# cartesia = Cartesia Sonic (paid)              ← production
DEV_TTS=edge

# ── Groq (FREE tier covers all development) ───
GROQ_API_KEY=

# ── Cartesia (production TTS, paid) ───────────
CARTESIA_API_KEY=
CARTESIA_VOICE_ID_AMERICAN=
CARTESIA_VOICE_ID_BRITISH=

# ── Supabase (free tier) ───────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Upstash Redis (free tier) ─────────────────
REDIS_URL=rediss://your-redis.upstash.io:6379
REDIS_TOKEN=

# ── Azure Speech (optional, Tier 2 pron) ──────
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# ── Mobile app URLs ────────────────────────────
EXPO_PUBLIC_BACKEND_WS_URL=ws://192.168.x.x:8000
EXPO_PUBLIC_BACKEND_HTTP_URL=http://192.168.x.x:8000
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

PORT=8000
